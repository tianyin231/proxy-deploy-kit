{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "direct-doh",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query"
      }
    ],
    "final": "direct-doh",
    "rules": []
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "relay-vless",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "<EXIT_ID>",
          "uuid": "<VLESS_UUID>",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.cloudflare.com",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.cloudflare.com",
            "server_port": 443
          },
          "private_key": "<REALITY_PRIVATE_KEY>",
          "short_id": [
            "<REALITY_SHORT_ID>"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "ip_is_private": true,
        "action": "reject"
      },
      {
        "auth_user": [
          "<EXIT_ID>"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "inbound": [
          "relay-vless"
        ],
        "action": "reject"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "direct-doh"
  }
}
