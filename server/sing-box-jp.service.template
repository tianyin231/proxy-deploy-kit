# Copy to /etc/systemd/system/sing-box-jp.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sing-box-jp
#
# Adjust ExecStart if sing-box or the config path is installed elsewhere.
# ProtectSystem=strict makes /etc and /usr read-only for the process; certs
# and config under /etc/sing-box-jp remain readable.

[Unit]
Description=sing-box Japan VLESS Reality and Hysteria2
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sing-box run -c /etc/sing-box-jp/config.json
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
